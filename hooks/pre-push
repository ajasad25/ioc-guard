#!/usr/bin/env bash
# ioc-guard pre-push hook.
# Blocks non-fast-forward pushes, branch deletions, and pushes carrying indicators.
#
# Two escape hatches, in order of preference:
#
#   IOC_GUARD_SKIP_SCAN=1 git push ...
#       Skips only the content scan. The force-push and deletion blocks still
#       apply. This is the supported way to publish an update to iocs.txt, or
#       any document that quotes the indicators; without it the scanner
#       correctly flags its own indicator list and the push is refused.
#
#   IOC_GUARD=off git push ...
#       Disables EVERY check, force-push and deletion included. Logged.
#       Reach for this only when deliberately force-pushing a cleaned repo.
set -uo pipefail

ENGINE="${IOC_GUARD_ENGINE:-$HOME/.git-hooks/ioc-guard}"
PYTHON="${IOC_GUARD_PYTHON:-python3}"
LOG="${IOC_GUARD_LOG:-$HOME/.git-hooks/override.log}"
MAX_COMMITS="${IOC_GUARD_MAX_COMMITS:-50}"
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

remote_name="${1:-origin}"
remote_url="${2:-unknown}"

# 0 clean, 1 findings, 2 operational error. Worst code wins, and a scanner that
# fell over must never be mistaken for a clean scan.
status=0
scan_seq=0

bump() {
  if [ "$1" -gt "$status" ]; then status="$1"; fi
}

# True if $1 is an all-zero object id. Length-agnostic: SHA-1 repos use 40
# zeros, SHA-256 repos (--object-format=sha256) use 64. Comparing against a
# hardcoded 40-zero string would misclassify deletions/new-branches in a
# SHA-256 repo.
is_zero_oid() {
  case "${1:-}" in
    "")      return 1 ;;
    *[!0]*)  return 1 ;;
    *)       return 0 ;;
  esac
}

if [ "${IOC_GUARD:-on}" = "off" ]; then
  mkdir -p "$(dirname "$LOG")"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  logged=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    printf '%s OVERRIDE repo=%s remote=%s ref=%s local=%s remote_sha=%s cwd=%s\n' \
      "$ts" "$remote_url" "$remote_name" "$remote_ref" "$local_sha" "$remote_sha" "$PWD" >> "$LOG"
    logged=1
  done
  if [ "$logged" = "0" ]; then
    printf '%s OVERRIDE repo=%s remote=%s (no refs on stdin) cwd=%s\n' \
      "$ts" "$remote_url" "$remote_name" "$PWD" >> "$LOG"
  fi
  echo "ioc-guard: OVERRIDE ACTIVE — push not scanned. Logged to $LOG" >&2
  exit 0
fi

if [ ! -f "$ENGINE/iocs.txt" ]; then
  echo "ioc-guard: ERROR: engine not found at $ENGINE — run hooks/install.sh" >&2
  exit 2
fi

SCRATCH="$(mktemp -d)" || {
  echo "ioc-guard: ERROR: mktemp -d failed; refusing the push." >&2
  exit 2
}
trap 'rm -rf "$SCRATCH"' EXIT

skip_scan=0
if [ -n "${IOC_GUARD_SKIP_SCAN:-}" ] && [ "${IOC_GUARD_SKIP_SCAN}" != "0" ]; then
  skip_scan=1
fi

# Materialise the files one commit changed and scan them.
#   $1 commit to read the file contents from
#   $2 "" to use the commit's own parents, or a ref to diff against
#   $3 human label for messages
# Returns 0 clean, 1 findings, 2 operational error.
scan_commit() {
  local commit="$1" against="$2" label="$3"
  local paths_file tmp rc
  local -a paths pipe_status

  scan_seq=$((scan_seq + 1))
  paths_file="$SCRATCH/paths.$scan_seq"
  tmp="$SCRATCH/tree.$scan_seq"

  if [ -n "$against" ]; then
    git diff -z --name-only --diff-filter=d "$against" "$commit" \
      > "$paths_file" 2>/dev/null </dev/null
  else
    # --root so a root commit diffs against the empty tree instead of failing,
    # and -c so a merge contributes only its own resolution: everything the
    # merge brought in is already covered by the side commits in the range.
    git diff-tree --no-commit-id -r --root -z --diff-filter=d --name-only -c \
      "$commit" > "$paths_file" 2>/dev/null </dev/null
  fi
  if [ "$?" != "0" ]; then
    echo "ioc-guard: ERROR: could not list changed paths for $label." >&2
    echo "  Refusing the push rather than scanning nothing." >&2
    return 2
  fi

  # NUL-delimited end to end: git's default core.quotePath=true C-quotes and
  # octal-escapes any path with a non-ASCII byte, embedded quote, backslash
  # or control char under plain --name-only. A quoted string like
  # "caf\303\251.js" then matches no real path when handed to `git archive`,
  # which silently archives nothing -- so the scan would silently run on an
  # empty directory and report clean on an infected file. -z avoids that
  # quoting entirely.
  paths=()
  while IFS= read -r -d '' line; do paths+=("$line"); done < "$paths_file"
  if [ "${#paths[@]}" -eq 0 ]; then
    return 0
  fi

  mkdir -p "$tmp" || return 2
  git archive "$commit" -- "${paths[@]}" 2>/dev/null </dev/null | tar -x -C "$tmp" 2>/dev/null
  pipe_status=("${PIPESTATUS[@]}")
  if [ "${pipe_status[0]}" != "0" ] || [ "${pipe_status[1]}" != "0" ]; then
    echo "ioc-guard: ERROR: could not materialise $label" >&2
    echo "  (git archive=${pipe_status[0]}, tar=${pipe_status[1]}). Refusing the push" >&2
    echo "  rather than scanning an empty directory." >&2
    return 2
  fi

  # The report goes to a file and is printed only when something is wrong.
  # A range of 30 commits would otherwise emit 30 "clean" lines, and a "clean"
  # line printed immediately after a BLOCKED verdict reads like the verdict.
  # stderr is left to flow through, so errors and the skipped-file count show.
  PYTHONPATH="$ENGINE" "$PYTHON" -m ioc_guard --root "$tmp" --iocs "$ENGINE/iocs.txt" \
    > "$SCRATCH/report.$scan_seq" </dev/null
  rc=$?
  if [ "$rc" != "0" ]; then cat "$SCRATCH/report.$scan_seq" >&2; fi
  case "$rc" in
    0|1) return "$rc" ;;
    *)   return 2 ;;
  esac
}

classify() {   # $1 rc, $2 label
  case "$1" in
    0) ;;
    1) echo "ioc-guard: BLOCKED — indicators found in $2" >&2
       echo "  to override: IOC_GUARD=off git push ..." >&2
       bump 1 ;;
    *) echo "ioc-guard: ERROR: scanner failed on $2 — refusing the push rather than assuming clean." >&2
       bump 2 ;;
  esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  if is_zero_oid "$local_sha"; then
    echo "ioc-guard: BLOCKED — branch deletion of $remote_ref" >&2
    echo "  to override: IOC_GUARD=off git push ..." >&2
    bump 1
    continue
  fi

  if ! is_zero_oid "$remote_sha"; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "ioc-guard: BLOCKED — non-fast-forward push to $remote_ref" >&2
      echo "  remote $remote_sha is not a known ancestor of local $local_sha" >&2
      echo "  (this also fires if the remote's current tip isn't in your local history yet —" >&2
      echo "  if you believe this is an ordinary push, run: git fetch && git rebase, then push again)" >&2
      echo "  to deliberately force-push (e.g. cleaning an infected repo): IOC_GUARD=off git push ..." >&2
      bump 1
      continue
    fi
    base="$remote_sha"
    have_base=1
  else
    base="$EMPTY_TREE"
    have_base=0
  fi

  if [ "$skip_scan" = "1" ]; then
    echo "ioc-guard: IOC_GUARD_SKIP_SCAN=1 — content scan skipped for $remote_ref." >&2
    echo "  The force-push and deletion checks still applied." >&2
  else
    # The tip tree, so the state actually being published is always scanned.
    scan_commit "$local_sha" "$base" "the tip of $remote_ref"
    classify "$?" "commits bound for $remote_ref"

    # Every commit in the range, not just the tip. The payload "rewrote itself
    # out of the working tree after running, to hide": add it in one commit,
    # remove it in the next, and a tip-only scan reports clean.
    commits_file="$SCRATCH/commits.$scan_seq"
    if [ "$have_base" = "1" ]; then
      git rev-list "$base..$local_sha" > "$commits_file" 2>/dev/null </dev/null
    else
      # New branch: everything not already reachable from a remote-tracking ref.
      git rev-list "$local_sha" --not --remotes > "$commits_file" 2>/dev/null </dev/null
    fi
    if [ "$?" != "0" ]; then
      echo "ioc-guard: ERROR: could not list the commits being pushed to $remote_ref." >&2
      bump 2
      continue
    fi

    total="$(wc -l < "$commits_file" | tr -d ' ')"
    if [ "$total" -gt "$MAX_COMMITS" ]; then
      echo "ioc-guard: WARNING: $total commits bound for $remote_ref; scanning the" >&2
      echo "  newest $MAX_COMMITS only. $((total - MAX_COMMITS)) older commit(s) in this push were" >&2
      echo "  NOT scanned commit-by-commit — their surviving content is still covered by" >&2
      echo "  the tip scan above. Push in smaller batches for full history coverage." >&2
    fi

    n=0
    while read -r commit; do
      [ -z "${commit:-}" ] && continue
      n=$((n + 1))
      if [ "$n" -gt "$MAX_COMMITS" ]; then break; fi
      # The tip's own diff is already covered by the tip scan above.
      if [ "$commit" = "$local_sha" ] && [ "$have_base" = "1" ]; then continue; fi
      scan_commit "$commit" "" "commit $commit"
      classify "$?" "commit $commit (bound for $remote_ref)"
    done < "$commits_file"
  fi

  # The .gitignore and CRLF rules need the base revision, and they need a real
  # git repository -- not the archive tmpdir. A separate, diff-only invocation
  # against the repo itself, comparing the base the remote actually has against
  # the ref being pushed.
  if [ "$have_base" = "1" ]; then
    scan_seq=$((scan_seq + 1))
    PYTHONPATH="$ENGINE" "$PYTHON" -m ioc_guard --root "$PWD" --iocs "$ENGINE/iocs.txt" \
      --base-ref "$base" --head-ref "$local_sha" --diff-only \
      > "$SCRATCH/report.$scan_seq" </dev/null
    rc=$?
    if [ "$rc" != "0" ]; then cat "$SCRATCH/report.$scan_seq" >&2; fi
    case "$rc" in
      0) ;;
      1) echo "ioc-guard: BLOCKED — .gitignore/CRLF damage in the range pushed to $remote_ref" >&2
         echo "  to override: IOC_GUARD=off git push ..." >&2
         bump 1 ;;
      *) echo "ioc-guard: ERROR: diff-rule pass failed for $remote_ref — refusing the push." >&2
         bump 2 ;;
    esac
  fi
done

exit $status
