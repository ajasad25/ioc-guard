#!/usr/bin/env bash
# ioc-guard pre-push hook.
# Blocks non-fast-forward pushes, branch deletions, and pushes carrying indicators.
# Escape hatch for cleaning an infected repo: IOC_GUARD=off git push ...
set -uo pipefail

ENGINE="${IOC_GUARD_ENGINE:-$HOME/.git-hooks/ioc-guard}"
PYTHON="${IOC_GUARD_PYTHON:-python3}"
LOG="${IOC_GUARD_LOG:-$HOME/.git-hooks/override.log}"
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
ZERO=0000000000000000000000000000000000000000

remote_name="${1:-origin}"
remote_url="${2:-unknown}"

if [ "${IOC_GUARD:-on}" = "off" ]; then
  mkdir -p "$(dirname "$LOG")"
  printf '%s OVERRIDE repo=%s remote=%s cwd=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$remote_url" "$remote_name" "$PWD" >> "$LOG"
  echo "ioc-guard: OVERRIDE ACTIVE — push not scanned. Logged to $LOG" >&2
  exit 0
fi

if [ ! -f "$ENGINE/iocs.txt" ]; then
  echo "ioc-guard: ERROR: engine not found at $ENGINE — run hooks/install.sh" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  if [ "$local_sha" = "$ZERO" ]; then
    echo "ioc-guard: BLOCKED — branch deletion of $remote_ref" >&2
    echo "  to override: IOC_GUARD=off git push ..." >&2
    status=1
    continue
  fi

  if [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "ioc-guard: BLOCKED — non-fast-forward push to $remote_ref" >&2
      echo "  remote $remote_sha is not a known ancestor of local $local_sha" >&2
      echo "  (this also fires if the remote's current tip isn't in your local history yet —" >&2
      echo "  if you believe this is an ordinary push, run: git fetch && git rebase, then push again)" >&2
      echo "  to deliberately force-push (e.g. cleaning an infected repo): IOC_GUARD=off git push ..." >&2
      status=1
      continue
    fi
    base="$remote_sha"
  else
    base="$EMPTY_TREE"
  fi

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT

  paths=()
  while IFS= read -r line; do paths+=("$line"); done \
    < <(git diff --name-only --diff-filter=d "$base" "$local_sha" 2>/dev/null </dev/null)

  if [ "${#paths[@]}" -gt 0 ]; then
    git archive "$local_sha" -- "${paths[@]}" 2>/dev/null </dev/null | tar -x -C "$tmp" 2>/dev/null
    PYTHONPATH="$ENGINE" "$PYTHON" -m ioc_guard --root "$tmp" --iocs "$ENGINE/iocs.txt" </dev/null
    rc=$?
    if [ "$rc" = "2" ]; then
      echo "ioc-guard: ERROR: scanner failed — refusing the push rather than assuming clean." >&2
      status=1
    elif [ "$rc" = "1" ]; then
      echo "ioc-guard: BLOCKED — indicators found in commits bound for $remote_ref" >&2
      echo "  to override: IOC_GUARD=off git push ..." >&2
      status=1
    fi
  fi

  rm -rf "$tmp"
  trap - EXIT
done

exit $status
